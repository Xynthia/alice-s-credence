[sub_resource type="Resource" id="Resource_sym2d"]
script = ExtResource("3_cjhpt")
text = "You remember your promotion and how you wanted a small office to work better."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_jrumy"]
script = ExtResource("3_cjhpt")
text = "eventually they changed the janitors closet to an office."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_xqoe6"]
script = ExtResource("3_cjhpt")
text = "The police don't have much money.
so this was already a lot."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_vbxak"]
script = ExtResource("3_cjhpt")
text = "..."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_wfdn8"]
script = ExtResource("3_cjhpt")
text = "Wait. What is this?"
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_ldpl7"]
script = ExtResource("3_cjhpt")
text = "A letter with my name and a cd, with play me written on it. "
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_l5ho0"]
script = ExtResource("3_cjhpt")
text = "Who's sick joke is this?..."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_mdpuj"]
script = ExtResource("3_cjhpt")
text = " maybe it isn't a joke. I should play it."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_yuwuw"]
script = ExtResource("6_kad1h")
dialog_lines = Array[ExtResource("3_cjhpt")]([SubResource("Resource_sym2d"), SubResource("Resource_jrumy"), SubResource("Resource_xqoe6"), SubResource("Resource_vbxak"), SubResource("Resource_wfdn8"), SubResource("Resource_ldpl7"), SubResource("Resource_l5ho0"), SubResource("Resource_mdpuj")])
metadata/_custom_type_script = "uid://hvdj3dvv56ce"

[sub_resource type="Resource" id="Resource_0deay"]
script = ExtResource("3_cjhpt")
text = "What... it's started a program."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_ak33y"]
script = ExtResource("3_cjhpt")
text = "Is this... Oh No! "
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_4jqp7"]
script = ExtResource("3_cjhpt")
text = "It's Alice, the missing kid!"
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_mbuhx"]
script = ExtResource("3_cjhpt")
text = "We only have a few hours left before her file gets closed."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_05yv3"]
script = ExtResource("3_cjhpt")
text = "Maybe i can talk to her and get some more information about where she is..."
metadata/_custom_type_script = "uid://c2wmtfnafrvdl"

[sub_resource type="Resource" id="Resource_tn3fl"]
